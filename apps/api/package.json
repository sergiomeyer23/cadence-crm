{
  "name": "@cadence/api",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Sérgio Gabriel Meyer Camargo (https://github.com/sergiomeyer23)",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiomeyer23/cadence-crm.git",
    "directory": "apps/api"
  },
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node ../../scripts/build-node.mjs index=src/index.ts migrate=../../packages/db/src/scripts/migrate.ts seed=../../packages/db/src/scripts/seed.ts --copy=../../packages/db/drizzle:drizzle",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bull-board/api": "^9.13.1",
    "@bull-board/fastify": "^9.13.1",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cadence/db": "workspace:*",
    "@cadence/shared": "workspace:*"
  }
}
