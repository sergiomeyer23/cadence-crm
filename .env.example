# Copie para .env. Os valores abaixo servem só para desenvolvimento local.
DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence
TEST_DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence_test
REDIS_URL=redis://localhost:6379

API_PORT=3333
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
# lax funciona quando web e API estão no mesmo domínio. Use none (com
# COOKIE_SECURE=true) só se a web chamar a API direto em outro domínio.
COOKIE_SAME_SITE=lax
# Origens que podem chamar a API com cookie, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
# true em produção atrás de proxy (Vercel, Render, Railway). Localmente fica
# false para ninguém forjar o IP pelo cabeçalho X-Forwarded-For.
TRUST_PROXY=false
# Quantos leads por minuto cada IP pode enviar pelo widget do site.
PUBLIC_LEADS_PER_MINUTE=10

# Acesso ao Bull Board em /admin/queues (autenticação básica)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=troque-esta-senha

# Agendamento dos jobs repetíveis
RETENTION_ANALYSIS_EVERY_MS=60000
WEEKLY_REPORT_CRON=0 8 * * 1
WEEKLY_REPORT_TZ=America/Sao_Paulo

# Ajustes opcionais da regra de frequência, em JSON. Exemplo:
# FREQUENCY_RULE_OVERRIDES={"windowDays":21,"absenceCeilingDays":12}
